# Sao chép thành .env (KHÔNG commit .env). Trên Hostinger: khai báo các biến này trong phần Environment variables.
NODE_ENV=production
PORT=3000
SITE_URL=https://tenmiencuaban.vn
# Chuỗi ngẫu nhiên dài để ký cookie đăng nhập. Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Tài khoản quản trị tạo lần đầu bởi: npm run seed (hoặc node lib/seed.js --admin-only). Bỏ trống mật khẩu để hệ thống tự sinh.
ADMIN_USER=admin
ADMIN_PASSWORD=
# (Tuỳ chọn) Nơi lưu CSDL và ảnh tải lên, nên đặt NGOÀI thư mục code để không mất khi deploy lại
# DB_PATH=/home/USER/tb-data/tbgroup.db
# UPLOAD_DIR=/home/USER/tb-data/uploads

# --- Thông báo đăng ký (mỗi nhóm đều tuỳ chọn) ---
# Email (SMTP của Hostinger: smtp.hostinger.com, cổng 465, secure=true)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TB GROUP <no-reply@tenmiencuaban.vn>"
NOTIFY_EMAIL_TO=
# Telegram: tạo bot với @BotFather, lấy chat id của nhóm nhận tin
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Google Sheets qua Apps Script (xem README mục 5)
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=
# Webhook chung (Zalo OA/ZNS qua cầu nối, Make, n8n...)
LEAD_WEBHOOK_URL=
