<!doctype html>
<html lang="vi" style="--accent:<%= page.accent %>;--accent-soft:<%= page.accent2 %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= page.title %></title>
<meta name="description" content="<%= page.desc %>">
<link rel="canonical" href="<%= canonical %>">
<meta name="theme-color" content="#0a3d14">
<meta property="og:type" content="website">
<meta property="og:locale" content="vi_VN">
<meta property="og:title" content="<%= page.title %>">
<meta property="og:description" content="<%= page.desc %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:image" content="<%= mainUrl %><%= page.image %>">
<link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32.png">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="/css/landing.css?v=1">
<script type="application/ld+json"><%- JSON.stringify({ '@context': 'https://schema.org', '@type': 'Organization', name: 'TB GROUP', legalName: 'Công ty cổ phần Tập đoàn TB Việt Nam', url: mainUrl, logo: mainUrl + '/img/icon-512.png', telephone: C.phone ? '+84' + C.phone.replace(/^0/, '') : undefined }).replace(/</g, '\\u003c') %></script>
</head>
<body data-program="<%= page.program %>" data-meta="<%= track.meta %>" data-tiktok="<%= track.tiktok %>" data-ga4="<%= track.ga4 %>" data-gads="<%= track.gads %>" data-gads-label="<%= track.gadsLabel %>">
<a class="skip" href="#dang-ky">Đến form đăng ký</a>
<header class="lp-head">
  <div class="wrap lp-head__in">
    <a class="lp-brand" href="<%= base || '/' %>" aria-label="TB GROUP">
      <img src="/img/logo-mark.png" width="40" height="43" alt="">
      <span><strong>TB GROUP</strong><small><%= page.label %></small></span>
    </a>
    <nav class="lp-head__nav" aria-label="Điều hướng">
      <% (typeof navLinks !== 'undefined' ? navLinks : []).forEach(function (n) { %><a href="#<%= n[0] %>"><%= n[1] %></a><% }) %>
    </nav>
    <% if (C.phone) { %><a class="btn btn--call" href="tel:<%= C.phone %>" data-track="Contact" data-channel="phone"><svg class="i" aria-hidden="true" viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg><span><%= C.phoneShow %></span></a><% } %>
  </div>
</header>
<main id="main">
