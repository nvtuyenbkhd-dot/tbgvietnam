<%- include('partials/head') %>
<% const title = L(item, 'title'); %>
<section class="page-head">
  <div class="container container--narrow">
    <p class="crumbs"><a href="<%= u('/') %>"><%= t('nav.home') %></a> / <a href="<%= u('/tin-tuc') %>"><%= t('nav.news') %></a></p>
    <p class="page-head__meta"><span class="tag tag--soft"><%= t('news.cat_' + item.category) %></span> <time datetime="<%= item.published_at %>"><%= fmtDate(item.published_at) %></time></p>
    <h1><%= title %></h1>
  </div>
</section>
<section class="section section--tight">
  <div class="container container--narrow">
    <% let srcs = []; try { srcs = JSON.parse(item.sources || '[]'); } catch (e) {} %>
    <% if (item.image) { %><figure class="post-fig"><img class="detail__img" src="<%= item.image %>" alt="<%= item.image_alt || title %>" width="960" height="540" fetchpriority="high"><% if (item.image_credit) { %><figcaption><%= item.image_credit %></figcaption><% } %></figure><% } %>
    <% if (item.youtube && /^[A-Za-z0-9_-]{11}$/.test(item.youtube)) { %><figure class="post-video"><div class="post-video__frame"><iframe src="https://www.youtube-nocookie.com/embed/<%= item.youtube %>" title="<%= title %>" loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div></figure><% } %>
    <div class="prose prose--lg"><%- richText(L(item, 'body')) %></div>
    <% let gal = []; try { gal = JSON.parse(item.gallery || '[]'); } catch (e) {} %>
    <% if (gal.length) { const caps = t('news.gallery_caps'); %><section class="postgal-wrap" aria-label="<%= t('news.gallery_title') %>"><h2><%= t('news.gallery_title') %></h2><div class="postgal">
      <% gal.forEach(function (g) { const air = g.src.indexOf('/img/activity/air') === 0; %><figure><img src="<%= g.src %>" width="<%= air ? 750 : 1000 %>" height="<%= air ? 1000 : 750 %>" loading="lazy" alt="<%= caps[g.kind] %>"><figcaption><%= caps[g.kind] %></figcaption></figure><% }) %>
    </div></section><% } %>
    <% if (srcs.length) { %><section class="post-sources" aria-labelledby="src-h"><h2 id="src-h"><%= t('news.sources') %></h2><ol>
      <% srcs.forEach(function (s) { %><li><a href="<%= s.url %>" target="_blank" rel="noopener nofollow"><%= s.title %></a><% if (s.publisher) { %> — <%= s.publisher %><% } %><% if (s.accessed) { %> (<%= s.accessed %>)<% } %></li><% }) %>
    </ol></section><% } %>
    <aside class="inline-cta">
      <h2><%= t('home.cta_title') %></h2>
      <a class="btn btn--primary" href="<%= u('/lien-he') %>#dang-ky"><%= t('nav.register') %><svg class="i" aria-hidden="true"><use href="#i-arrow"/></svg></a>
    </aside>
  </div>
</section>
<% if (related.length) { %>
<section class="section section--alt"><div class="container">
  <header class="sec-head"><div><h2><%= t('news.related') %></h2></div></header>
  <div class="grid grid--3"><% related.forEach(function (p) { %><%- include('partials/post-card', { p }) %><% }) %></div>
</div></section>
<% } %>
<%- include('partials/foot') %>
