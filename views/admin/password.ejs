<%- include('_head') %>
<h1>Đổi mật khẩu</h1>
<form class="edit" method="post" action="/admin/password" autocomplete="off">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Mật khẩu hiện tại<input type="password" name="current" autocomplete="current-password" required></label>
  <label>Mật khẩu mới (tối thiểu 10 ký tự)<input type="password" name="next" autocomplete="new-password" minlength="10" required></label>
  <label>Nhập lại mật khẩu mới<input type="password" name="confirm" autocomplete="new-password" minlength="10" required></label>
  <div class="row"><button class="btn btn--primary" type="submit">Đổi mật khẩu</button></div>
</form>
<%- include('_foot') %>
