<%- include('partials/head') %>
<% const base = u('/' + JOB_PATH[category]); %>
<section class="page-head prog-<%= category %>">
  <div class="container">
    <p class="crumbs"><a href="<%= u('/') %>"><%= t('nav.home') %></a> / <span><%= t('nav.' + category) %></span></p>
    <h1><%= t(category + '.title') %></h1>
    <p><%= t(category + '.sub') %></p>
  </div>
</section>

<% if (category === 'engineer') { %>
<section class="section section--tight">
  <div class="container">
    <header class="sec-head"><div><h2><%= t('engineer.benefits_title') %></h2></div></header>
    <div class="why why--3">
      <% const bi = ['coin', 'home', 'users']; t('engineer.benefits').forEach(function (b, i) { %>
        <div class="why__item"><span class="why__icon"><svg class="i i--lg" aria-hidden="true"><use href="#i-<%= bi[i] %>"/></svg></span><h3><%= b.t %></h3><p><%= b.d %></p></div>
      <% }) %>
    </div>
  </div>
</section>
<% } else { %>
<section class="section section--tight"><div class="container"><p class="lead"><%= t('labor.intro') %></p></div></section>
<% } %>

<section class="section section--tight<%= category === 'engineer' ? ' section--alt' : '' %>" id="danh-sach">
  <div class="container">
    <form class="filters" method="get" action="<%= base %>#danh-sach" role="search">
      <div class="field"><label for="q"><%= t('common.search') %></label><input id="q" name="q" type="search" value="<%= filters.q %>" placeholder="<%= t('common.search_ph') %>"></div>
      <div class="field"><label for="industry"><%= t('job.filter_industry') %></label>
        <select id="industry" name="industry"><option value=""><%= t('common.all') %></option><% industries.forEach(function (c) { %><option value="<%= c.v %>"<%- filters.industry === c.v ? ' selected' : '' %>><%= c.label %></option><% }) %></select></div>
      <div class="field"><label for="location"><%= t('job.filter_location') %></label>
        <select id="location" name="location"><option value=""><%= t('common.all') %></option><% locations.forEach(function (c) { %><option value="<%= c.v %>"<%- filters.location === c.v ? ' selected' : '' %>><%= c.label %></option><% }) %></select></div>
      <button class="btn btn--primary" type="submit"><svg class="i" aria-hidden="true"><use href="#i-search"/></svg><%= t('common.search') %></button>
    </form>
    <p class="count"><strong><%= total %></strong> <%= t('common.results') %></p>
    <% if (items.length) { %>
      <div class="grid grid--3"><% items.forEach(function (j) { %><%- include('partials/job-card', { j }) %><% }) %></div>
      <%- include('partials/pager') %>
    <% } else { %>
      <div class="empty"><p><%= t('common.no_results') %></p></div>
    <% } %>
  </div>
</section>

<% if (category === 'engineer') { %>
<section class="section">
  <div class="container">
    <header class="sec-head"><div><h2><%= t('engineer.compare_title') %></h2></div></header>
    <div class="table-wrap">
      <table class="compare">
        <thead><tr><% t('engineer.compare_cols').forEach(function (c, i) { %><th scope="col"<%- i === 1 ? ' class="is-us"' : '' %>><%= c %></th><% }) %></tr></thead>
        <tbody><% t('engineer.compare_rows').forEach(function (r) { %><tr><th scope="row"><%= r[0] %></th><td class="is-us"><%= r[1] %></td><td><%= r[2] %></td></tr><% }) %></tbody>
      </table>
    </div>
    <p class="note"><%= t('engineer.compare_note') %></p>
  </div>
</section>
<section class="section section--alt">
  <div class="container who">
    <div>
      <h2><%= t('engineer.who_title') %></h2>
      <ul class="ticks"><% t('engineer.who').forEach(function (w) { %><li><svg class="i" aria-hidden="true"><use href="#i-check"/></svg><span><%= w %></span></li><% }) %></ul>
      <p class="lead"><%= t('engineer.who_note') %></p>
      <a class="btn btn--primary" href="#dang-ky"><%= t('engineer.check_cta') %><svg class="i" aria-hidden="true"><use href="#i-arrow"/></svg></a>
    </div>
  </div>
</section>
<% } %>

<section class="cta cta--slim" id="dang-ky">
  <div class="container cta__in">
    <div class="cta__copy"><h2><%= t('home.cta_title') %></h2><p><%= t('home.cta_sub') %></p></div>
    <div class="cta__form"><%- include('partials/lead-form', { id: 'jobs', program: category }) %></div>
  </div>
</section>
<%- include('partials/foot') %>
