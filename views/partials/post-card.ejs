<article class="card card--post">
  <a class="card__media" href="<%= u('/tin-tuc/' + p.slug) %>" tabindex="-1" aria-hidden="true">
    <% if (p.image) { %><img src="<%= p.image %>" alt="" loading="lazy" width="640" height="360"><% } else { %><span class="card__ph"><svg class="i i--xl"><use href="#i-globe"/></svg></span><% } %>
  </a>
  <div class="card__body">
    <p class="card__meta"><span class="tag tag--soft"><%= t('news.cat_' + p.category) %></span><time datetime="<%= p.published_at %>"><%= fmtDate(p.published_at) %></time></p>
    <h3 class="card__title"><a href="<%= u('/tin-tuc/' + p.slug) %>"><%= L(p, 'title') %></a></h3>
    <p class="card__text"><%= L(p, 'excerpt') %></p>
  </div>
</article>
